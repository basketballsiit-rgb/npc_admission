# Environment Configuration Example for NPC_Admission

# Database Connection
# SQLite (Local test): "file:./dev.db"
# PostgreSQL (Production): "postgresql://username:password@localhost:5432/npc_admission?schema=public"
# MySQL (Production): "mysql://username:password@localhost:3306/npc_admission"
DATABASE_URL="file:./dev.db"

# Security: Citizen ID Encryption & HMAC Hashing (Generate 32-byte hex keys)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CID_ENCRYPTION_KEY="replace_with_32_bytes_hex_encryption_key"
CID_HMAC_SECRET="replace_with_secure_hmac_secret"

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
